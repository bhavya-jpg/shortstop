{
  "name": "shortstop",
  "version": "0.1.0",
  "description": "Explainable drug-shortage response agent for hospital pharmacy teams. Demonstration system, not clinical decision support.",
  "license": "Apache-2.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p .",
    "test": "vitest run",
    "test:hmem:conformance": "tsx vendor/hmem/conformance/runner.ts",
    "check": "npm run typecheck && npm test && npm run test:hmem:conformance",
    "shortstop": "tsx src/cli.ts",
    "data:openfda": "tsx scripts/fetch-openfda-snapshot.ts",
    "data:synthetic": "tsx scripts/generate-synthetic.ts",
    "data:postgres-seed": "tsx scripts/generate-postgres-seed.ts",
    "examples": "tsx scripts/generate-examples.ts",
    "test:live": "vitest run --config vitest.live.config.ts",
    "ui": "tsx src/serve.ts",
    "ui:sample": "SAMPLE_MODE=true tsx src/serve.ts",
    "ui:live": "SAMPLE_MODE=false tsx src/serve.ts"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^2.1.9"
  }
}
