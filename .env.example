# ShortStop configuration. Copy to .env and fill in real values locally.
# Placeholders only: never commit real keys. .env is gitignored.

# --- Mode -------------------------------------------------------------------
# true  = run on the bundled sample data with deterministic sample agents.
#         No Zetaris or Nightshift call is made and every output says so.
# false = live mode. Zetaris and Nightshift must be configured; failures are
#         reported as errors. Live mode never falls back to sample data.
SAMPLE_MODE=true

# --- Zetaris (data layer) ------------------------------------------------------
ZETARIS_REST_URL=http://localhost:8888/api/v1.0
ZETARIS_ORG_ID=1
ZETARIS_API_KEY=your-zetaris-api-key
ZETARIS_TIMEOUT_MS=60000
ZETARIS_MAX_RETRIES=2
# Fully qualified Zetaris table names, set after the tables are registered
# (created by `npm run shortstop -- register openfda|hospital`; unverified until run live). Placeholders until verified on a live instance.
ZETARIS_TABLE_SHORTAGES=shortstop.shortages_v
ZETARIS_TABLE_FORMULARY=hospital_pg.formulary
ZETARIS_TABLE_INVENTORY=hospital_pg.inventory
ZETARIS_TABLE_USAGE=hospital_pg.usage
ZETARIS_TABLE_POLICIES=hospital_pg.policies

# --- Meterless Nightshift (primary AI provider) --------------------------------
# Copy the URL and runtime token from Nightshift's Console. The NVIDIA key goes
# in Nightshift's Providers tab, never here.
METERLESS_BASE_URL=http://127.0.0.1:8088/v1
METERLESS_RUNTIME_TOKEN=your-nightshift-runtime-token
# A routing mode read from GET /v1/models (for example meterless/auto).
METERLESS_MODEL=meterless/auto
METERLESS_APP=shortstop
METERLESS_SCOPE=user
METERLESS_TIMEOUT_MS=180000
METERLESS_MAX_RETRIES=3

# --- Agent bounds and runtime ---------------------------------------------------
SHORTSTOP_MAX_REVISIONS=2
SHORTSTOP_MAX_CANDIDATES=3
SHORTSTOP_STATE_DIR=var
SHORTSTOP_LOG_DIR=logs
LOG_LEVEL=info
PORT=8000

# --- Local PostgreSQL holding the SYNTHETIC hospital tables (seed-postgres, register hospital)
# PGUSER and PGPASSWORD are read at run time and never written to any file.
PGUSER=your-postgres-user
PGPASSWORD=your-postgres-password
PGHOST=127.0.0.1
PGPORT=5432
SHORTSTOP_PG_DATABASE=shortstop_synthetic
# How the Zetaris containers reach this host's PostgreSQL (Docker Desktop):
SHORTSTOP_PG_HOST_FOR_ZETARIS=host.docker.internal
